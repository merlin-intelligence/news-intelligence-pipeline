# Copy to .env (never commit .env). Loaded automatically by `python -m newsintel`.

# Brave Search API key — optional. Enables the brave_news / brave_web / site
# channels and is the fallback for resolving Google News links.
# Get one at https://api-dashboard.search.brave.com
BRAVE_API_KEY=

# Seconds between Brave calls (free plan: 1 request/second).
# BRAVE_MIN_INTERVAL=1.05
