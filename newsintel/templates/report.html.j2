{#- Report template. Context is built by newsintel.report.render(); every
    value is auto-escaped. Styles live in report.css (inlined, so the report
    stays a single self-contained file). -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
{% include "report.css" %}
</style>
</head>
<body>
<header><div class="wrap">
  <h1>{{ title }}</h1>
  <p class="sub">{{ subtitle }}</p>
  <p class="sub">Last {{ days }} days · generated {{ generated }}</p>
  <div class="stats">
    {%- for value, label in stats %}
    <div class="stat"><b>{{ value }}</b><span>{{ label }}</span></div>
    {%- endfor %}
  </div>
</div></header>

<main class="wrap">
  {%- if categories %}
  <h2>Categories</h2>
  <div class="grid">
    {%- for c in categories %}
    <div class="cat">
      <div class="count">{{ c.count }} articles · {{ c.in_top }} in top</div>
      <h3>{{ c.name }}</h3>
      <p>{{ c.description }}</p>
    </div>
    {%- endfor %}
  </div>
  {%- endif %}

  <h2>Top stories ({{ top | length }})</h2>
  {%- for a in top %}
  <article class="card">
    <h3><a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.title }}</a></h3>
    <div class="meta">{% for m in a.meta %}<span>{{ m }}</span>{% endfor %}</div>
    <div class="tags">{% if a.category %}<span class="tag">{{ a.category }}</span>{% endif %}</div>
    <p class="summary">{{ a.summary }}</p>
    <div class="scores">
      {%- for label, value in a.bars %}
      <div>{{ label }} <b>{{ value }}</b><div class="bar"><i style="width:{{ value }}%"></i></div></div>
      {%- endfor %}
    </div>
  </article>
  {%- else %}
  <p>No article selected.</p>
  {%- endfor %}

  {%- if further %}
  <h2>Further reading ({{ further | length }})</h2>
  <div class="table-wrap"><table>
    <thead><tr><th class="num">Rank</th><th>Date</th><th>Article</th><th>Category</th><th class="num">Score</th></tr></thead>
    <tbody>
      {%- for a in further %}
      <tr>
        <td class="num">{{ a.rank }}</td>
        <td>{{ a.date }}</td>
        <td><a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.title }}</a><br><small>{{ a.source }}</small></td>
        <td>{{ a.category }}</td>
        <td class="num">{{ a.score }}</td>
      </tr>
      {%- endfor %}
    </tbody>
  </table></div>
  {%- endif %}

  <h2>Method</h2>
  <ul class="method">
    <li>Sources: {{ channels }}.</li>
    <li>Articles are opened and their full text extracted; pages that are blocked or too short are excluded.</li>
    <li>Score = {{ weights }}, rescaled so the best article scores 100.</li>
    <li><b>Relevance</b>: closeness to the topic description and keywords. <b>Category match</b>: closeness to the best-matching category, each category weighted equally. <b>Novelty</b>: how different the article is from more relevant ones. <b>Centrality</b>: how much the article bridges otherwise separate stories.
      {%- if uses_hinge %} <b>Hinge</b>: how strongly an article near the centre of the coverage links its two opposite poles.{% endif %}</li>
    <li>
      {%- if theta %}Top stories are a diverse subset of the best-scored articles (Lovász θ). {% endif -%}
      Near-duplicate stories are shown once{% if coverage %}, and every category gets at least one top story when available{% endif %}.</li>
  </ul>
</main>

<footer><div class="wrap">Generated by newsintel · project “{{ project }}”</div></footer>
</body>
</html>
